// Test program for single-cycle RISC-V core.
// x1 = mem[0]        (lw x1, 0(x0))
// x2 = mem[4]        (lw x2, 4(x0))
// x3 = x1 + x2       (add x3, x1, x2)
// mem[8] = x3        (sw x3, 8(x0))
// if (x1 == x1) PC += 8   (beq x1, x1, 8)  -> taken, skips next instr
// x4 = x1 + x2       (SKIPPED)
// x5 = x3 + x3       (add x5, x3, x3)
//
// I-type ALU (addi/ori/andi), starting right after the branch target:
// x10 = 5                (addi x10, x0, 5)
// x11 = 3                (addi x11, x0, 3)
// x12 = x10 | 8  = 13    (ori  x12, x10, 8)
// x13 = x10 & 1  = 1     (andi x13, x10, 1)
// x14 = x10 + x11 = 8    (add  x14, x10, x11)
// x15 = x10 - x11 = 2    (sub  x15, x10, x11)

